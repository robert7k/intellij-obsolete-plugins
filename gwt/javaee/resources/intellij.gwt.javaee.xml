<!--
  Integration with Java EE application servers. Both plugins below require an IntelliJ IDEA Ultimate subscription;
  without them this content module is simply not loaded and the rest of the GWT plugin keeps working.
-->
<idea-plugin>
  <dependencies>
    <plugin id="com.intellij.javaee.app.servers.integration"/>
    <plugin id="com.intellij.javaee.web"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij.gwt">
    <sampleApplicationRunConfigurator implementation="com.intellij.gwt.javaee.GwtJavaeeSampleApplicationRunConfigurator"/>
  </extensions>
</idea-plugin>
